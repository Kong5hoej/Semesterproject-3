@page "/posts/{PostId:int}/chats/{Buyer}"

@using BlazorApp.Auth
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Services
@rendermode InteractiveServer

@inject IHttpPostsService PostsService
@inject IHttpChatsService ChatsService
@inject IHttpMessagesService MessagesService

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        
<section>
    <div class="container py-5">

        <div class="row d-flex justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-6">

                <div class="card">
                    <div class="card-header d-flex flex-column justify-content-between p-3" style="background-color:lightgray">
                        <div style="display: flex;">
                            <h5 class="mb-0" style="flex: auto;">
                                Chat med
                                <div class="d-inline" style="cursor: pointer" @onclick="e => GoToProfile(OtherUser)">
                                    @OtherUser
                                </div>
                            </h5>
                            <button @onclick="CancelMess" data-mdb-button-init data-mdb-ripple-init type="button" class="btn-close"  id="button-addon2" style="margin-left: 5px;padding-top: .55rem;"></button>
                        </div>
                        <div class="d-flex align-items-center">@PostTitle</div>
                    </div>
                    <div class="card-body d-flex overflow-y-auto flex-column-reverse position-relative" data-mdb-perfect-scrollbar-init style="height: 400px; background-color:#f7f7f7;">
                        <div>
                            @foreach(MessageDTO message in AllMessages){
                                <div class="d-flex @GetContentDirection(message)">
                                    <p class="small mb-1"><b>
                                        <div style="cursor: pointer;" @onclick="e => GoToProfile(message.Sender)">
                                            @message.Sender
                                        </div>
                                    </b></p>
                                    &nbsp;
                                    <p class="small mb-1 text-muted">@message.TimeStamp.Substring(0, @message.TimeStamp.LastIndexOf('.'))</p>
                                </div>
                                <div class="d-flex flex-row @GetContentDirection(message)">
                                    <p class="small p-2 me-3 mb-3 rounded-3 bg-body-tertiary">@message.Message</p>
                                </div>
                            }
                            
                            <!-- End of messages -->
                            @if (!string.IsNullOrEmpty(ErrorLabel)){
                                <div class="m-3">
                                    <p class="text-danger">@ErrorLabel</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer text-muted d-flex justify-content-start align-items-center p-3" style="background-color:lightgray">
                        <div class="input-group mb-0">
                            <textarea @bind="MessageInput" 
                                    @bind:event="oninput"
                                    type="text" class="form-control" 
                                    placeholder="Indtast Besked"
                                    @onkeydown="@(async e => { if (e.Key == "Enter" && e.CtrlKey) { await SubmitMess(); } })"
                                    required></textarea>
                            <button @onclick="SubmitMess" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary" type="button" id="button-addon" style="padding-top: .55rem;">
                                Send Besked
                            </button>
                            <!--button @onclick="CancelMess" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary" type="button" id="button-addon2" style="margin-left: 5px;padding-top: .55rem;">
                                Fortryd
                            <button-->
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
    </Authorized>
</AuthorizeView>


@code 
{
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    [Parameter] public int PostId { get; set; }
    [Parameter] public string Buyer { get; set; }

    public string ThisPostOwner { get; set; } = string.Empty;
    public string LoggedInUser{ get; set; }
    public string OtherUser{ get; set; }

    public string PostTitle { get; set; } = string.Empty;
    public ChatDTO Chat{ get; set; }
    public List<MessageDTO> AllMessages { get; set; } = [];
    public string MessageInput { get; set; } = string.Empty;

    public string ErrorLabel { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Get The UserName Of The Currently Logged In User
        var identity = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity;
        if (identity == null)
            return;
        LoggedInUser = identity.Name;
        
        // Get Content Of Post
        PostDTO postDto = await PostsService.GetPost(PostId);
        
        PostTitle = postDto.Title;
        ThisPostOwner = postDto.Owner;
        
        Chat = await ChatsService.GetChatAsync(PostId, Buyer);
        AllMessages = Chat.Messages;

        OtherUser = LoggedInUser == ThisPostOwner ? Chat.Sender : ThisPostOwner;
    }

    public async Task SubmitMess()
    {
        ErrorLabel = "";
        if (string.IsNullOrEmpty(MessageInput))
            ErrorLabel = "Beskeden må ikke være tom";

        if (string.IsNullOrEmpty(ErrorLabel))
        {
            // Attach Mess To Chat
            MessageDTO messageDTO = new MessageDTO() {
                Sender = LoggedInUser,
                Message = MessageInput,
                TimeStamp = ""
            };
            
            try
            {
                // Make A Message For This Chat
                await MessagesService.SendMessage(PostId, Buyer, messageDTO);
                MessageInput = "";
                NavigationManager.NavigateTo(NavigationManager.Uri, true);
            }
            catch (Exception e){
                // throw;
                ErrorLabel = e.InnerException.Message;
            }
        }
    }

    public void CancelMess()
    {
        NavigationManager.NavigateTo($"/posts/{PostId}");
    }
    
    private AuthProvider GetAuthProvider(){
        if (AuthProvider is not AuthProvider provider) throw new Exception("Cannot get Auth Provider");
        return provider;
    }

    private void GoToProfile(string username){
        NavigationManager.NavigateTo($"user/{username}");
    }

    private string GetContentDirection(MessageDTO message){
        string dir = message.Sender == LoggedInUser ? "end" : "start";
        return $"justify-content-{dir}";
    }
}
