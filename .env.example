# Copy this file to .env (same folder, the repo root) and fill in your own values.
# .env is git-ignored. Do not put quotes around values.

# PostgreSQL login used by java_project
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password

# JWT signing key shared by the WebAPI and BlazorApp. At least 32 random characters,
# e.g. generate one with: openssl rand -hex 32
Jwt__Key=replace-with-at-least-32-random-characters
